            ]
        ]
    },
    {
        "id": "function-alerts",
        "type": "function",
        "z": "d87b79adc0e4a65e",
        "name": "Classification Alertes",
        "func": "// CORRECTION : msg.payload est déjà un objet, pas besoin de JSON.parse\nvar data = msg.payload;\n\n// Fonction de classification des alertes\nfunction classify(value, normalMin, normalMax, critMin, critMax){\n    if(value < critMin || value > critMax){ return 'Critique'; }\n    if(value < normalMin || value > normalMax){ return 'Attention'; }\n    return 'Normal';\n}\n\n// Calcul des alertes individuelles\nvar alertBpm = classify(data.bpm, 60, 100, 50, 120);\nvar alertTemp = classify(data.temperature, 36.5, 37.5, 36, 38.5);\nvar alertSpo2 = classify(data.spo2, 95, 100, 92, 100);\nvar alertTension = classify(data.systolic, 110, 130, 90, 160);\n\n// Détermination du statut global du patient\nvar globalStatus = 'Normal';\nif(alertBpm === 'Critique' || alertTemp === 'Critique' || alertSpo2 === 'Critique' || alertTension === 'Critique') {\n    globalStatus = 'Critique';\n} else if(alertBpm === 'Attention' || alertTemp === 'Attention' || alertSpo2 === 'Attention' || alertTension === 'Attention') {\n    globalStatus = 'Attention';\n}\n\n// FORMATAGE REQUIS POUR INFLUXDB v2\nmsg.measurement = \"sante_patients\";\nmsg.payload = {\n    fields: {\n        bpm: Number(data.bpm),\n        temperature: Number(data.temperature),\n        spo2: Number(data.spo2),\n        systolic: Number(data.systolic),\n        diastolic: Number(data.diastolic)\n    },\n    tags: {\n        patient_id: data.patient_id || \"Inconnu\",\n        statut_global: globalStatus,\n        alerte_bpm: alertBpm,\n        alerte_temp: alertTemp,\n        alerte_spo2: alertSpo2,\n        alerte_tension: alertTension\n    },\n    timestamp: Date.now()\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 200,
        "wires": [
            [
                "influxdb-out"
            ]
        ]
    },
