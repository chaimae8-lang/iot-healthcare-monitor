    {
        "id": "mqtt-in",
        "type": "mqtt in",
        "z": "d87b79adc0e4a65e",
        "name": "Données Patients",
        "topic": "patients/+/data",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "627d01e02a5fa48b",
        "nl": false,
        "rap": false,
        "rh": "0",
